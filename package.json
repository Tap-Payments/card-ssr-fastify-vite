{
	"name": "ssr-react-fastify",
	"version": "1.0.0",
	"description": "React TypeScript SSR with Fastify",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"predev": "node scripts/generateTheme.js && node scripts/generateLocale.js",
		"build": "npm run build:client && npm run build:wrapper && npm run build:server",		
		"build:client": "vite build --config vite.config.client.js",
		"build:wrapper": "vite build --config vite.config.wrapper.js",
		"build:server": "tsc -p tsconfig.server.json",
		"build:watch": "concurrently \"npm run build:client -- --watch\" \"npm run build:wrapper -- --watch\" \"npm run build:server -- --watch\"",
		"dev": "concurrently \"npm run build:watch\" \"nodemon dist/index.js\"",
		"start": "cross-env NODE_ENV=production node dist/index.js"
	},
	"dependencies": {
		"@tap-payments/acceptance-sdk": "^0.0.72",
		"@tap-payments/card-web": "1.0.46-development",
		"classnames": "^2.3.2",
		"credit-card-type": "^10.0.2",
		"framer-motion": "^12.19.2",
		"helmet": "^6.0.1",
		"node-rsa": "^1.1.1",
		"nodemon": "^2.0.20",
		"prettier": "^3.6.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.23.0",
		"react-use": "^17.6.0",
		"redis": "^4.6.5",
		"ts-node": "^10.9.1",
		"vite-tsconfig-paths": "^4.0.5"
	},
	"devDependencies": {
		"cross-env": "^7.0.3",
		"@fastify/autoload": "^6.3.1",
		"@fastify/compress": "^8.0.3",
		"@fastify/cors": "^11.0.1",
		"@fastify/helmet": "^13.0.1",
		"@fastify/jwt": "^9.1.0",
		"@fastify/middie": "^9.0.3",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/redis": "^7.0.2",
		"@fastify/sensible": "^6.0.3",
		"@fastify/static": "^8.2.0",
		"@fastify/view": "^11.1.0",
		"@fvilers/disable-react-devtools": "^1.3.0",
		"@react-input/mask": "^2.0.4",
		"@reduxjs/toolkit": "^2.8.2",
		"@sanitise/uri": "^0.1.1",
		"@slack/webhook": "^7.0.5",
		"@types/node": "^20.9.0",
		"@types/node-rsa": "^1.1.4",
		"@types/react": "^18.2.15",
		"@types/react-dom": "^18.2.7",
		"@types/react-router-dom": "^5.3.3",
		"@vitejs/plugin-react": "^4.2.1",
		"axios": "^1.10.0",
		"card-validator": "^10.0.2",
		"concurrently": "^9.2.0",
		"dotenv": "^16.5.0",
		"esbuild": "^0.25.5",
		"fastify": "^5.4.0",
		"i18next": "^25.2.1",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-http-backend": "^3.0.2",
		"lint-staged": "^13.1.2",
		"node-fetch": "^3.3.2",
		"react-i18next": "^15.5.3",
		"react-redux": "^9.2.0",
		"tsx": "^4.7.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.36.0",
		"vite": "^5.2.0"
	}
}
