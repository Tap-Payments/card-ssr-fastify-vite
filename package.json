{
	"name": "card-ssr-fastify-vite",
	"version": "1.0.0",
	"description": "A card ssr fastify vite app",
	"repository": {
		"type": "git",
		"url": "https://github.com/Tap-Payments/Card-SSR-Fastifay.git"
	},
	"author": {
		"name": "Mahmoud Fahmi"
	},
	"license": "MIT",
	"_moduleAliases": {
		"@server": "src/server",
		"@shared": "src/shared"
	},
	"scripts": {
		"dev:client": "yarn build:client && vite --config vite.config.ts dev",
		"dev:server": "nodemon -e ts,tsx --exec 'ts-node src/server/index.ts'",
		"build:client": "cross-env NODE_ENV=production vite build --outDir dist/client --ssrManifest",
		"build:server": "cross-env NODE_ENV=production vite build --ssr src/client/entry-server.tsx --outDir dist/server",
		"build": "rimraf dist && tsc -p tsconfig.prod.json && yarn build:client && yarn build:server && yarn copy-files",
		"typecheck": "tsc --noEmit",
		"serve": "cross-env NODE_ENV=production yarn ts-node src/server/index.ts",
		"clean": "rimraf dist/",
		"copy-files": "cpx 'static/**/*' dist/assets && cpx index.html dist && cpx 'dist/client/assets/**/*' dist/assets",
		"prepare": "npx husky install ",
		"lint-staged:setup": "npx husky add .husky/pre-commit 'yarn lint-staged'",
		"prettier": "prettier --list-different \"src/**/*.{md,mdx,ts,js,tsx,jsx,json}\" *.json",
		"prettier:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md,css,json}\" *.json",
		"lint": "eslint src --color --ext .js,.jsx,.ts,.tsx,.json",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix"
	},
	"dependencies": {
		"@tap-payments/acceptance-sdk": "^0.0.72",
		"@tap-payments/card-web": "1.0.46-development",
		"classnames": "^2.3.2",
		"compression": "^1.7.4",
		"credit-card-type": "^10.0.2",
		"cross-env": "^7.0.3",
		"framer-motion": "^12.19.2",
		"helmet": "^6.0.1",
		"module-alias": "^2.2.2",
		"node-rsa": "^1.1.1",
		"nodemon": "^2.0.20",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.23.0",
		"react-use": "^17.6.0",
		"redis": "^4.6.5",
		"serve-static": "^1.15.0",
		"ts-node": "^10.9.1",
		"vite-tsconfig-paths": "^4.0.5"
	},
	"devDependencies": {
		"@fastify/autoload": "^6.3.1",
		"@fastify/compress": "^8.0.3",
		"@fastify/cors": "^11.0.1",
		"@fastify/helmet": "^13.0.1",
		"@fastify/http-proxy": "^11.3.0",
		"@fastify/jwt": "^9.1.0",
		"@fastify/middie": "^9.0.3",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/redis": "^7.0.2",
		"@fastify/sensible": "^6.0.3",
		"@fastify/static": "^8.2.0",
		"@fastify/view": "^11.1.0",
		"@fvilers/disable-react-devtools": "^1.3.0",
		"@react-input/mask": "^2.0.4",
		"@reduxjs/toolkit": "^2.8.2",
		"@sanitise/uri": "^0.1.1",
		"@slack/webhook": "^7.0.5",
		"@types/module-alias": "^2.0.1",
		"@types/node": "^20.9.0",
		"@types/node-rsa": "^1.1.4",
		"@types/react": "^18.2.15",
		"@types/react-dom": "^18.2.7",
		"@types/react-router-dom": "^5.3.3",
		"@typescript-eslint/eslint-plugin": "^5.54.1",
		"@typescript-eslint/parser": "^5.54.1",
		"@vitejs/plugin-react": "^4.2.1",
		"axios": "^1.10.0",
		"card-validator": "^10.0.2",
		"cpx": "^1.5.0",
		"dotenv": "^16.5.0",
		"esbuild": "^0.25.5",
		"eslint": "^8.35.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-prettier": "^8.7.0",
		"eslint-plugin-import": "^2.27.5",
		"eslint-plugin-jsx-a11y": "^6.7.1",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^4.2.1",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"fastify": "^5.4.0",
		"fastify-vite": "^3.0.0-beta.27",
		"husky": "^8.0.3",
		"i18next": "^25.2.1",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-http-backend": "^3.0.2",
		"lint-staged": "^13.1.2",
		"node-fetch": "^3.3.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.21",
		"prettier": "^3.6.1",
		"react-i18next": "^15.5.3",
		"react-redux": "^9.2.0",
		"rimraf": "^4.1.2",
		"tsx": "^4.7.0",
		"typescript": "^5.4.0",
		"vite": "^5.2.0"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx,json,js,jsx}": [
			"yarn run prettier:fix",
			"yarn run lint",
			"git add ."
		]
	}
}
