{
	"extends": "./tsconfig.paths.json",
	"compilerOptions": {
		"noImplicitAny": false,
		"allowJs": true,
		"alwaysStrict": true,
		"allowSyntheticDefaultImports": true,
		"baseUrl": ".",
		"checkJs": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,
		"jsx": "react-jsxdev",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"strict": true,
		"outDir": "dist",
		"module": "ESNext",
		"moduleResolution": "node",
		"moduleDetection": "force",
		"skipLibCheck": true,
		"sourceMap": true,
		"target": "ES2020"
	},
	"include": ["src/server", "src/shared", "src/index.ts"],
	"exclude": ["node_modules", "dist", "src/client"]
}
