{
	"extends": "./tsconfig.paths.json",
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,         // Allows default imports from modules that don't have a default export
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": false,
	},
	"include": ["src/client", "src/server", "src/shared", "src/wrapper", "scripts"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
